#!/bin/bash
# Test script to verify Docker build setup works correctly

set -e

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
REPO_DIR="$SCRIPT_DIR/../.."

echo "============================================="
echo "Testing Docker build setup..."
echo "============================================="

# Check if Docker is available
if ! command -v docker &> /dev/null; then
    echo "ERROR: Docker is not installed or not in PATH"
    exit 1
fi

echo "✓ Docker is available"

# Check if the build-and-copy script exists and is executable
if [ ! -x "$SCRIPT_DIR/build-and-copy" ]; then
    echo "ERROR: build-and-copy script is not executable"
    exit 1
fi

echo "✓ build-and-copy script is ready"

# Check if required directories exist
if [ ! -d "$REPO_DIR" ]; then
    echo "ERROR: Repository directory not found"
    exit 1
fi

echo "✓ Repository structure is valid"

echo ""
echo "Docker build environment is ready!"
echo ""
echo "To build firmware and copy outputs, run:"
echo "  ./tools/docker/build-and-copy"
echo ""
echo "To start an interactive development session, run:"
echo "  ./tools/docker/env"
echo ""
echo "============================================="


